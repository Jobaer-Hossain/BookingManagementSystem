@model Consultant

@{
    ViewData["Title"] = "Delete Customer";
}

<h1>Delete Customer</h1>

<div class="alert alert-warning" role="alert">
    This action is permanent. Are you sure you want to delete this customer?
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5">@Model.Name</h2>
        <p class="mb-1"><strong>Email:</strong> @Model.Email</p>
        <p class="mb-1"><strong>Phone:</strong> @Model.Phone</p>
        <p class="mb-0"><strong>Specialization:</strong> @Model.Specialization</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Delete Customer</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
