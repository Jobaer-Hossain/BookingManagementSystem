@model Consultant

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" autocomplete="name" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Email" class="form-label"></label>
    <input asp-for="Email" class="form-control" autocomplete="email" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Phone" class="form-label"></label>
    <input asp-for="Phone" class="form-control" autocomplete="tel" />
    <span asp-validation-for="Phone" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Specialization" class="form-label"></label>
    <textarea asp-for="Specialization" class="form-control" rows="3" ></textarea>
    <span asp-validation-for="Specialization" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="AppointmentDuration" class="form-label"></label>
    <input asp-for="AppointmentDuration" class="form-control" autocomplete="AppointmentDuration" />
    <span asp-validation-for="AppointmentDuration" class="text-danger"></span>
</div>
