@model Consultant

@{
    ViewData["Title"] = "Consultant Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Consultant Details</h1>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Consultant</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9"><a href="mailto:@Model.Email">@Model.Email</a></dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.Phone</dd>
            <dt class="col-sm-3">Specialization</dt>
            <dd class="col-sm-9">@Model.Specialization</dd>
            <dt class="col-sm-3">Appointment Duration</dt>
            <dd class="col-sm-9">@Model.AppointmentDuration</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.Status ? "Active" : "Inactive")</dd>
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">Back to Consultant</a>
