@model ErrorViewModel

@{
    ViewData["Title"] = "Something went wrong";
}

<div class="text-center py-5">
    <h1 class="text-danger">Something went wrong</h1>
    <p>We could not complete your request. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted"><small>Reference: @Model.RequestId</small></p>
    }
    <a asp-controller="Customers" asp-action="Index" class="btn btn-primary">Return to Customers</a>
</div>
